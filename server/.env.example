# JobFinder Automation — Environment Variables
# Copy this file to .env and fill in your own keys. Never commit .env!

# --- Server ---
PORT=5000

# --- Supabase (database) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- n8n ---
N8N_WEBHOOK_URL=https://your-n8n.onrender.com/webhook/Fresher

# --- PhantomBuster (LinkedIn scraping source) ---
PHANTOMBUSTER_API_KEY=your-phantombuster-api-key
PHANTOMBUSTER_AGENT_ID=your-phantombuster-agent-id

# --- Adzuna (official jobs API source) ---
# Free signup: https://developer.adzuna.com/ -> get APP_ID + APP_KEY
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# --- JSearch via RapidAPI (aggregated jobs source) ---
# Subscribe (free tier): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your-rapidapi-key

# --- Telegram (optional server-side use) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- Scheduler ---
# Set to 'false' to disable the automatic 6-hour scraping cycle (for manual testing)
ENABLE_SCHEDULER=true
# Cron expression for the automated cycle (default: every 6 hours)
AUTO_SCHEDULE_CRON=0 */6 * * *
